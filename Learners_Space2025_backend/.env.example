# PostgreSQL database used by normal app runs.
LS_DATABASE_ENGINE=postgres
POSTGRES_DB=learners_space25
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Tests use SQLite by default so they do not need a running Postgres server.
# Set this to postgres when you explicitly want tests to use PostgreSQL.
LS_TEST_DATABASE=sqlite

# SMTP email settings required for real OTP delivery.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=replace-me@example.com

# Console email is only for local debugging. Do not enable in production.
DJANGO_ALLOW_CONSOLE_EMAIL=false

# OTP behavior.
SIGNUP_OTP_TIMEOUT_SECONDS=600
SIGNUP_OTP_RESEND_SECONDS=60
